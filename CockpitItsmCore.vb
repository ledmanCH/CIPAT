' Cockpit ITSM public API - runtime core of the VB.NET classes generated by CIPAT
' (Cockpit ITSM Public API Toolkit). .NET 6+, no dependency (HttpClient,
' System.Text.Json.Nodes).
'
' Maintained by hand, embedded in CIPAT and written next to each generated class:
' do not edit a copy, it is replaced when it differs from the generator's version.
'
' - OAuth 2.0 token (client_credentials, multipart/form-data, scope public-api),
'   renewed before expiry and once more on a 401 response (thread-safe);
' - HTTP: HttpClient, given to the constructor or created (proxy and certificates
'   of the system);
' - paged lists: every page read, items merged and truncated to
'   totalNumberOfElements (FetchAllPagesAsync);
' - conversion helpers used by the generated classes (missing or null = Nothing).
'
' Namespace Global.CockpitItsm: independent of the root namespace of the project.

Option Strict On
Option Explicit On
Option Infer On

Imports System.Collections
Imports System.Collections.Generic
Imports System.Globalization
Imports System.Linq
Imports System.Net
Imports System.Net.Http
Imports System.Net.Http.Headers
Imports System.Text
Imports System.Text.Json
Imports System.Text.Json.Nodes
Imports System.Threading
Imports System.Threading.Tasks

Namespace Global.CockpitItsm

    ''' <summary>Error of a Cockpit ITSM call: HTTP status (0 = network error or invalid response) and response body.</summary>
    Public Class CockpitItsmException
        Inherits Exception

        Public ReadOnly Property StatusCode As Integer
        Public ReadOnly Property Response As String

        Public Sub New(statusCode As Integer, message As String, Optional response As String = Nothing, Optional inner As Exception = Nothing)
            MyBase.New(message, inner)
            Me.StatusCode = statusCode
            Me.Response = If(response, "")
        End Sub
    End Class

    ''' <summary>Token, HTTP calls and paging. The generated class inherits from it.</summary>
    Public Class CockpitItsmCore
        Implements IDisposable

        Private Const DefaultPageSize As Integer = 500
        Private Shared ReadOnly TokenMargin As TimeSpan = TimeSpan.FromSeconds(60)

        Private ReadOnly _http As HttpClient
        Private ReadOnly _ownsHttp As Boolean
        Private ReadOnly _tokenLock As New SemaphoreSlim(1, 1)
        Private _saas As Boolean
        Private _tenant As String
        Private _clientId As String
        Private _clientSecret As String
        Private _token As String = ""
        Private _tokenExpiry As DateTimeOffset = DateTimeOffset.MinValue
        Private _pageSize As Integer = DefaultPageSize
        Private _lastStatus As Integer

        ''' <param name="saas">True: https://{tenant}.cockpit-itsm.com - False: https://{tenant}
        ''' (an on-premise tenant given with its scheme, e.g. http://host:8080, is used as is)</param>
        ''' <param name="tenant">Tenant name (SaaS) or host name (on premise)</param>
        ''' <param name="clientId">OAuth 2.0 client id (scope public-api)</param>
        ''' <param name="clientSecret">OAuth 2.0 client secret</param>
        ''' <param name="httpClient">HttpClient used for every request (proxy, certificates...); created if Nothing</param>
        Public Sub New(saas As Boolean, tenant As String, clientId As String, clientSecret As String, Optional httpClient As HttpClient = Nothing)
            _saas = saas
            _tenant = If(tenant, "")
            _clientId = If(clientId, "")
            _clientSecret = If(clientSecret, "")
            _ownsHttp = httpClient Is Nothing
            _http = If(httpClient, New HttpClient With {.Timeout = TimeSpan.FromSeconds(60)})
        End Sub

        ''' <summary>Releases the HttpClient created by the constructor (not the one given to it).</summary>
        Public Sub Dispose() Implements IDisposable.Dispose
            Dispose(True)
            GC.SuppressFinalize(Me)
        End Sub

        Protected Overridable Sub Dispose(disposing As Boolean)
            If Not disposing Then Return
            _tokenLock.Dispose()
            If _ownsHttp Then _http.Dispose()
        End Sub

        ' ------------------------------------------------------------------ settings (changing them discards the token)

        Public Property SaaS As Boolean
            Get
                Return _saas
            End Get
            Set(value As Boolean)
                _saas = value
                ClearToken()
            End Set
        End Property

        Public Property Tenant As String
            Get
                Return _tenant
            End Get
            Set(value As String)
                _tenant = If(value, "")
                ClearToken()
            End Set
        End Property

        Public Property ClientId As String
            Get
                Return _clientId
            End Get
            Set(value As String)
                _clientId = If(value, "")
                ClearToken()
            End Set
        End Property

        Public Property ClientSecret As String
            Get
                Return _clientSecret
            End Get
            Set(value As String)
                _clientSecret = If(value, "")
                ClearToken()
            End Set
        End Property

        ''' <summary>Page size of the paged lists (API maximum: 500).</summary>
        Public Property PageSize As Integer
            Get
                Return _pageSize
            End Get
            Set(value As Integer)
                _pageSize = If(value > 0, value, DefaultPageSize)
            End Set
        End Property

        ''' <summary>HTTP status of the last call.</summary>
        Public ReadOnly Property LastStatus As Integer
            Get
                Return _lastStatus
            End Get
        End Property

        Public Shared Function MakeBaseUrl(saas As Boolean, tenant As String) As String
            Dim result As String = If(tenant, "").Trim().TrimEnd("/"c)
            If saas Then Return "https://" & result & ".cockpit-itsm.com"
            Return If(result.Contains("://"), result, "https://" & result)
        End Function

        Public ReadOnly Property BaseUrl As String
            Get
                Return MakeBaseUrl(_saas, _tenant)
            End Get
        End Property

        ' ------------------------------------------------------------------ token

        Public ReadOnly Property AccessToken As String
            Get
                Return _token
            End Get
        End Property

        ''' <summary>Expiry of the token, 60 s before the server's one.</summary>
        Public ReadOnly Property TokenExpiry As DateTimeOffset
            Get
                Return _tokenExpiry
            End Get
        End Property

        Public ReadOnly Property IsTokenValid As Boolean
            Get
                Return _token.Length > 0 AndAlso DateTimeOffset.UtcNow < _tokenExpiry
            End Get
        End Property

        Public Sub ClearToken()
            _token = ""
            _tokenExpiry = DateTimeOffset.MinValue
        End Sub

        ''' <summary>Token obtained elsewhere (shared between instances).</summary>
        Public Sub SetToken(token As String, expiry As DateTimeOffset)
            _token = If(token, "")
            _tokenExpiry = expiry
        End Sub

        ''' <summary>POST /oauth2/token (multipart/form-data, client credentials, scope public-api).</summary>
        Public Async Function AuthenticateAsync(Optional cancellationToken As CancellationToken = Nothing) As Task
            ClearToken()
            If _tenant.Length = 0 OrElse _clientId.Length = 0 OrElse _clientSecret.Length = 0 Then
                Throw New CockpitItsmException(0, "Cockpit ITSM: tenant, ClientId and ClientSecret are required")
            End If
            ' multipart/form-data written as by the other cores (quoted names, no content
            ' type per part)
            Dim boundary As String = "----CockpitItsm" & Guid.NewGuid().ToString("N")
            Dim sb As New StringBuilder()
            Dim fields As String(,) = {{"grant_type", "client_credentials"}, {"client_id", _clientId},
                {"client_secret", _clientSecret}, {"scope", "public-api"}}
            For i As Integer = 0 To fields.GetLength(0) - 1
                sb.Append("--").Append(boundary).Append(vbCrLf & "Content-Disposition: form-data; name=""").Append(fields(i, 0)) _
                    .Append("""" & vbCrLf & vbCrLf).Append(fields(i, 1)).Append(vbCrLf)
            Next
            sb.Append("--").Append(boundary).Append("--" & vbCrLf)
            Dim answer As (Status As Integer, Text As String)
            Using form As New StringContent(sb.ToString(), Encoding.UTF8)
                form.Headers.ContentType = MediaTypeHeaderValue.Parse("multipart/form-data; boundary=" & boundary)
                answer = Await SendAsync(HttpMethod.Post, BaseUrl & "/oauth2/token", form, False, cancellationToken).ConfigureAwait(False)
            End Using
            _lastStatus = answer.Status
            If answer.Status <> 200 Then Throw MakeError(answer.Status, answer.Text)
            Dim obj = AsObj(Parse(answer.Text))
            Dim token As String = If(obj Is Nothing, Nothing, ToStr(obj("access_token")))
            If String.IsNullOrEmpty(token) Then
                Throw New CockpitItsmException(answer.Status, "Cockpit ITSM: no token in the response", answer.Text)
            End If
            Dim lifetime As TimeSpan = TimeSpan.FromSeconds(If(If(obj Is Nothing, Nothing, ToLong(obj("expires_in"))), 3600L))
            If lifetime > TokenMargin + TokenMargin Then lifetime -= TokenMargin
            _token = token
            _tokenExpiry = DateTimeOffset.UtcNow + lifetime
        End Function

        Private Async Function EnsureTokenAsync(usedToken As String, cancellationToken As CancellationToken) As Task
            Await _tokenLock.WaitAsync(cancellationToken).ConfigureAwait(False)
            Try
                ' Another call may have renewed it in the meantime
                If Not IsTokenValid OrElse _token = usedToken Then Await AuthenticateAsync(cancellationToken).ConfigureAwait(False)
            Finally
                _tokenLock.Release()
            End Try
        End Function

        ' ------------------------------------------------------------------ calls

        Private Async Function SendAsync(method As HttpMethod, url As String, content As HttpContent,
                                         auth As Boolean, cancellationToken As CancellationToken) As Task(Of (Status As Integer, Text As String))
            Using request As New HttpRequestMessage(method, url) With {.Content = content}
                request.Headers.Accept.Add(New MediaTypeWithQualityHeaderValue("application/json"))
                If auth Then request.Headers.Authorization = New AuthenticationHeaderValue("Bearer", _token)
                Try
                    Using response = Await _http.SendAsync(request, cancellationToken).ConfigureAwait(False)
                        Dim text As String = Await response.Content.ReadAsStringAsync(cancellationToken).ConfigureAwait(False)
                        Return (CInt(response.StatusCode), text)
                    End Using
                Catch e As OperationCanceledException When cancellationToken.IsCancellationRequested
                    Throw
                Catch e As Exception
                    Throw New CockpitItsmException(0, "Cockpit ITSM: " & e.GetType().Name & " - " & e.Message & " (" & url & ")", "", e)
                End Try
            End Using
        End Function

        Private Shared Function Content(body As String, method As HttpMethod) As StringContent
            If body Is Nothing AndAlso method <> HttpMethod.Post AndAlso method <> HttpMethod.Put AndAlso method <> HttpMethod.Patch Then Return Nothing
            Return New StringContent(If(body, ""), Encoding.UTF8, "application/json")
        End Function

        ''' <summary>Authenticated call; authenticates again once on 401; throws CockpitItsmException on a non-2xx status.</summary>
        ''' <param name="method">GET, POST, PUT, DELETE...</param>
        ''' <param name="pathQuery">e.g. "/api/end-users/12"</param>
        ''' <param name="body">text sent as is (JSON or plain text), Nothing = none</param>
        ''' <returns>raw response</returns>
        Public Async Function CallAsync(method As String, pathQuery As String, Optional body As String = Nothing,
                                        Optional cancellationToken As CancellationToken = Nothing) As Task(Of String)
            Dim httpMethod As New HttpMethod(method)
            Dim usedToken As String = _token
            If Not IsTokenValid Then Await EnsureTokenAsync(usedToken, cancellationToken).ConfigureAwait(False)
            usedToken = _token
            Dim answer = Await SendAsync(httpMethod, BaseUrl & pathQuery, Content(body, httpMethod), True, cancellationToken).ConfigureAwait(False)
            If answer.Status = HttpStatusCode.Unauthorized Then
                Await EnsureTokenAsync(usedToken, cancellationToken).ConfigureAwait(False)
                answer = Await SendAsync(httpMethod, BaseUrl & pathQuery, Content(body, httpMethod), True, cancellationToken).ConfigureAwait(False)
            End If
            _lastStatus = answer.Status
            If answer.Status < 200 OrElse answer.Status > 299 Then Throw MakeError(answer.Status, answer.Text)
            Return answer.Text
        End Function

        ''' <summary>Parsed JSON response, Nothing for an empty response.</summary>
        Public Async Function CallJsonAsync(method As String, pathQuery As String, Optional body As String = Nothing,
                                            Optional cancellationToken As CancellationToken = Nothing) As Task(Of JsonNode)
            Return Parse(Await CallAsync(method, pathQuery, body, cancellationToken).ConfigureAwait(False))
        End Function

        ''' <summary>Items ("content") of every page of a paged list, truncated to totalNumberOfElements.</summary>
        ''' <param name="pagePath">dotted path of the {page, pageSize} object in the body ("" = the body itself)</param>
        Public Async Function FetchAllPagesAsync(method As String, pathQuery As String, body As JsonObject, pagePath As String,
                                                 Optional cancellationToken As CancellationToken = Nothing) As Task(Of JsonArray)
            Dim root As JsonObject = If(body, New JsonObject())
            Dim pageObj As JsonObject = root
            If Not String.IsNullOrEmpty(pagePath) Then
                For Each name As String In pagePath.Split("."c)
                    Dim child = TryCast(pageObj(name), JsonObject)
                    If child Is Nothing Then
                        child = New JsonObject()
                        pageObj(name) = child
                    End If
                    pageObj = child
                Next
            End If
            Dim result As New JsonArray()
            Dim page As Integer = 0
            Dim totalPages As Long = 1
            Dim total As Long = -1
            Do
                pageObj("page") = page
                pageObj("pageSize") = _pageSize
                Dim resp = AsObj(Await CallJsonAsync(method, pathQuery, root.ToJsonString(), cancellationToken).ConfigureAwait(False))
                If resp Is Nothing Then Throw New CockpitItsmException(0, "Cockpit ITSM: invalid paged response")
                If page = 0 Then
                    totalPages = If(ToLong(resp("totalNumberOfPages")), 1L)
                    total = If(ToLong(resp("totalNumberOfElements")), -1L)
                End If
                Dim items = TryCast(resp("content"), JsonArray)
                If items Is Nothing OrElse items.Count = 0 Then Exit Do
                For Each item In items.ToList()
                    items.Remove(item)
                    result.Add(item)
                Next
                page += 1
            Loop While page < totalPages
            While total >= 0 AndAlso result.Count > total
                result.RemoveAt(result.Count - 1)
            End While
            Return result
        End Function

        Private Shared Function MakeError(status As Integer, text As String) As CockpitItsmException
            Dim msg As String = ""
            Try
                Dim o = TryCast(Parse(text), JsonObject)
                If o IsNot Nothing Then
                    msg = If({ToStr(o("errorMessage")), ToStr(o("error_description")), ToStr(o("error"))} _
                        .FirstOrDefault(Function(s) Not String.IsNullOrWhiteSpace(s)), "")
                End If
            Catch e As CockpitItsmException
                ' not JSON
            End Try
            If msg.Length = 0 Then
                msg = If(text, "").Trim()
                If msg.Length > 300 Then msg = msg.Substring(0, 300) & "..."
            End If
            Return New CockpitItsmException(status, "Cockpit ITSM: HTTP error " & status & " - " & msg, text)
        End Function

        ' ------------------------------------------------------------------ URL helpers

        Public Shared Function UrlEncode(value As Object) As String
            Return Uri.EscapeDataString(If(Convert.ToString(value, CultureInfo.InvariantCulture), ""))
        End Function

        ''' <summary>Query parameter; Nothing not sent, a list sent as repeated keys.</summary>
        Public Shared Sub AddQuery(query As List(Of KeyValuePair(Of String, String)), name As String, value As Object)
            If value Is Nothing Then Return
            If TypeOf value Is String Then
                query.Add(New KeyValuePair(Of String, String)(name, CStr(value)))
            ElseIf TypeOf value Is IEnumerable Then
                For Each item As Object In DirectCast(value, IEnumerable)
                    AddQuery(query, name, item)
                Next
            ElseIf TypeOf value Is Boolean Then
                query.Add(New KeyValuePair(Of String, String)(name, If(CBool(value), "true", "false")))
            ElseIf TypeOf value Is DateTimeOffset Then
                query.Add(New KeyValuePair(Of String, String)(name, FormatDateTime(DirectCast(value, DateTimeOffset))))
            ElseIf TypeOf value Is DateOnly Then
                query.Add(New KeyValuePair(Of String, String)(name, FormatDate(DirectCast(value, DateOnly))))
            ElseIf TypeOf value Is Double Then
                query.Add(New KeyValuePair(Of String, String)(name, CDbl(value).ToString("R", CultureInfo.InvariantCulture)))
            Else
                query.Add(New KeyValuePair(Of String, String)(name, If(Convert.ToString(value, CultureInfo.InvariantCulture), "")))
            End If
        End Sub

        ''' <summary>"" or "?a=1&amp;b=2"</summary>
        Public Shared Function QueryString(query As List(Of KeyValuePair(Of String, String))) As String
            If query.Count = 0 Then Return ""
            Return "?" & String.Join("&", query.Select(Function(kv) Uri.EscapeDataString(kv.Key) & "=" & Uri.EscapeDataString(kv.Value)))
        End Function

        ' ------------------------------------------------------------------ dates

        ''' <summary>ISO 8601 date-time (Z, +hh:mm, +hhmm, no offset = UTC); Nothing if invalid.</summary>
        Public Shared Function ParseDateTime(value As String) As DateTimeOffset?
            If value Is Nothing OrElse value.Trim().Length < 10 Then Return Nothing
            Dim s As String = value.Trim()
            If s.Length > 5 AndAlso (s(s.Length - 5) = "+"c OrElse s(s.Length - 5) = "-"c) AndAlso
               s.Substring(s.Length - 4).All(AddressOf Char.IsDigit) AndAlso s.Contains("T"c) Then
                s = s.Substring(0, s.Length - 2) & ":" & s.Substring(s.Length - 2)
            End If
            Dim result As DateTimeOffset
            If DateTimeOffset.TryParse(s, CultureInfo.InvariantCulture,
                                       DateTimeStyles.AssumeUniversal Or DateTimeStyles.AdjustToUniversal, result) Then Return result
            Return Nothing
        End Function

        ''' <summary>Date only "yyyy-mm-dd" (time and offset ignored); Nothing if invalid.</summary>
        Public Shared Function ParseDate(value As String) As DateOnly?
            If value Is Nothing OrElse value.Trim().Length < 10 Then Return Nothing
            Dim result As DateOnly
            If DateOnly.TryParseExact(value.Trim().Substring(0, 10), "yyyy-MM-dd", CultureInfo.InvariantCulture,
                                      DateTimeStyles.None, result) Then Return result
            Return Nothing
        End Function

        ''' <summary>UTC ISO 8601 with milliseconds ("2026-11-03T14:30:00.000Z").</summary>
        Public Shared Function FormatDateTime(value As DateTimeOffset) As String
            Return value.UtcDateTime.ToString("yyyy-MM-dd'T'HH:mm:ss.fff'Z'", CultureInfo.InvariantCulture)
        End Function

        Public Shared Function FormatDate(value As DateOnly) As String
            Return value.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)
        End Function

        ' ------------------------------------------------------------------ JSON: reading (Nothing if missing, null or invalid)

        ''' <summary>JSON text -> node; Nothing for an empty text.</summary>
        Public Shared Function Parse(text As String) As JsonNode
            If String.IsNullOrWhiteSpace(text) Then Return Nothing
            Try
                Return JsonNode.Parse(text)
            Catch e As JsonException
                Throw New CockpitItsmException(0, "Invalid JSON response: " & e.Message, text, e)
            End Try
        End Function

        Public Shared Function AsObj(node As JsonNode) As JsonObject
            Return TryCast(node, JsonObject)
        End Function

        Public Shared Function AsArr(node As JsonNode) As JsonArray
            Return TryCast(node, JsonArray)
        End Function

        ''' <summary>Text of a JSON string response ("abc" -> abc), other text unchanged.</summary>
        Public Shared Function Unquote(text As String) As String
            If text Is Nothing Then Return Nothing
            Dim s As String = text.Trim()
            If s.Length >= 2 AndAlso s(0) = """"c AndAlso s(s.Length - 1) = """"c Then
                Try
                    Dim node = JsonNode.Parse(s)
                    Return If(node Is Nothing, s, node.GetValue(Of String)())
                Catch e As Exception
                    Return text
                End Try
            End If
            Return text
        End Function

        Private Shared Function TryValue(Of T)(node As JsonNode, ByRef value As T) As Boolean
            Dim v = TryCast(node, JsonValue)
            If v IsNot Nothing AndAlso v.TryGetValue(Of T)(value) Then Return True
            value = Nothing
            Return False
        End Function

        Public Shared Function ToStr(node As JsonNode) As String
            If node Is Nothing Then Return Nothing
            Dim s As String = Nothing
            If TryValue(node, s) Then Return s
            Dim e As JsonElement
            If TryValue(node, e) AndAlso e.ValueKind = JsonValueKind.String Then Return e.GetString()
            Return node.ToJsonString()
        End Function

        Public Shared Function ToDouble(node As JsonNode) As Double?
            Dim d As Double
            If TryValue(node, d) Then Return d
            Dim s As String = If(TypeOf node Is JsonValue, ToStr(node), Nothing)
            If Double.TryParse(s, NumberStyles.Float, CultureInfo.InvariantCulture, d) Then Return d
            Return Nothing
        End Function

        Public Shared Function ToLong(node As JsonNode) As Long?
            Dim l As Long
            If TryValue(node, l) Then Return l
            Dim d As Double? = ToDouble(node)
            If d.HasValue Then Return CLng(Math.Truncate(d.Value))
            Return Nothing
        End Function

        Public Shared Function ToInt(node As JsonNode) As Integer?
            Dim l As Long? = ToLong(node)
            If l.HasValue Then Return CInt(l.Value)
            Return Nothing
        End Function

        Public Shared Function ToBool(node As JsonNode) As Boolean?
            Dim b As Boolean
            If TryValue(node, b) Then Return b
            Dim s As String = If(TypeOf node Is JsonValue, ToStr(node), Nothing)
            If s IsNot Nothing Then Return s.Trim().Equals("true", StringComparison.OrdinalIgnoreCase)
            Return Nothing
        End Function

        Public Shared Function ToDateTime(node As JsonNode) As DateTimeOffset?
            If TypeOf node Is JsonValue Then Return ParseDateTime(ToStr(node))
            Return Nothing
        End Function

        Public Shared Function ToDate(node As JsonNode) As DateOnly?
            If TypeOf node Is JsonValue Then Return ParseDate(ToStr(node))
            Return Nothing
        End Function

        ''' <summary>JSON text of a value (raw members).</summary>
        Public Shared Function ToRaw(node As JsonNode) As String
            Return node?.ToJsonString()
        End Function

        ''' <summary>Converted items of a JSON array (null or invalid items dropped); Nothing if the array is missing.</summary>
        Public Shared Function ListOf(Of T As Class)(node As JsonNode, conv As Func(Of JsonNode, T)) As List(Of T)
            Dim arr = TryCast(node, JsonArray)
            If arr Is Nothing Then Return Nothing
            Dim result As New List(Of T)(arr.Count)
            For Each item In arr
                Dim v As T = If(item Is Nothing, Nothing, conv(item))
                If v IsNot Nothing Then result.Add(v)
            Next
            Return result
        End Function

        ''' <summary>ListOf for value types (numbers, booleans, dates).</summary>
        Public Shared Function ListOfValues(Of T As Structure)(node As JsonNode, conv As Func(Of JsonNode, T?)) As List(Of T)
            Dim arr = TryCast(node, JsonArray)
            If arr Is Nothing Then Return Nothing
            Dim result As New List(Of T)(arr.Count)
            For Each item In arr
                Dim v As T? = If(item Is Nothing, Nothing, conv(item))
                If v.HasValue Then result.Add(v.Value)
            Next
            Return result
        End Function

        ' ------------------------------------------------------------------ JSON: writing (Nothing values are not written)

        ''' <summary>JSON array of the converted items of a list.</summary>
        Public Shared Function ArrayOf(Of T)(items As IEnumerable(Of T), conv As Func(Of T, JsonNode)) As JsonArray
            Dim result As New JsonArray()
            If items IsNot Nothing Then
                For Each item As T In items
                    result.Add(If(item Is Nothing, Nothing, conv(item)))
                Next
            End If
            Return result
        End Function

        Public Shared Function FromValue(value As String) As JsonNode
            Return If(value Is Nothing, Nothing, JsonValue.Create(value))
        End Function

        Public Shared Function FromValue(value As Long?) As JsonNode
            Return If(value.HasValue, JsonValue.Create(value.Value), Nothing)
        End Function

        Public Shared Function FromValue(value As Integer?) As JsonNode
            Return If(value.HasValue, JsonValue.Create(value.Value), Nothing)
        End Function

        Public Shared Function FromValue(value As Double?) As JsonNode
            Return If(value.HasValue, JsonValue.Create(value.Value), Nothing)
        End Function

        Public Shared Function FromValue(value As Boolean?) As JsonNode
            Return If(value.HasValue, JsonValue.Create(value.Value), Nothing)
        End Function

        Public Shared Function FromValue(value As DateTimeOffset?) As JsonNode
            Return If(value.HasValue, JsonValue.Create(FormatDateTime(value.Value)), Nothing)
        End Function

        Public Shared Function FromValue(value As DateOnly?) As JsonNode
            Return If(value.HasValue, JsonValue.Create(FormatDate(value.Value)), Nothing)
        End Function

        Public Shared Sub Put(obj As JsonObject, name As String, value As JsonNode)
            If value IsNot Nothing Then obj(name) = value
        End Sub

        ''' <summary>Raw member: JSON text inserted as a value.</summary>
        Public Shared Sub PutRaw(obj As JsonObject, name As String, json As String)
            If Not String.IsNullOrWhiteSpace(json) Then obj(name) = JsonNode.Parse(json)
        End Sub
    End Class

End Namespace
